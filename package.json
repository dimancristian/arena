
{
  "name": "math-arena",
  "version": "5.0.1",
  "private": true,
  "description": "Arena Matematica multiplayer cu intrebari FREE/PRO, licente PayPal, Dashboard MySQL si protectie anti-sharing.",
  "type": "commonjs",
